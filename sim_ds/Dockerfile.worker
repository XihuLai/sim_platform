FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SIM_DATA_DIR=/tmp/sim-worker

WORKDIR /app

RUN pip install --no-cache-dir "boto3>=1.35,<2" "httpx>=0.28,<1" "PyYAML>=6,<7" \
    && groupadd --gid 10001 simworker \
    && useradd --uid 10001 --gid simworker --no-create-home --shell /usr/sbin/nologin simworker

COPY backend /app/backend

USER 10001:10001
CMD ["python", "-m", "backend.sim.worker"]
